# ============================================================
#  إعدادات Supabase وDjango/Python
# ============================================================
#  1) انسخ هذا الملف باسم  .env  في نفس المجلد
#  2) أضف بيانات مشروع Supabase العامة (لا تضع service_role هنا)
#  3) أضف رابط Django API عند تشغيله
#  4) نفّذ: npm run build
#
#  عند ترك رابط Django فارغاً، يظل محتوى الموقع من src/data
#  بينما يستمر نموذج التواصل في استخدام Supabase.
# ============================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_DJANGO_API_URL=https://api.awexen.com/api
