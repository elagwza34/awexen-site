# Public browser configuration. Never put service_role or database passwords here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional override. Leave empty to use:
# VITE_SUPABASE_URL/functions/v1/lms-api
VITE_LMS_EDGE_URL=

# ---------------------------------------------------------------------------
# Local-only secrets. NEVER commit .env and NEVER expose these to the browser.
# Used only by scripts/ (npm run check:setup, npm run seed:lms).
# Find it in Supabase Dashboard → Project Settings → API Keys.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# Optional: admin auth user id, used by the seed script to publish a course.
# Leave empty to publish the course manually from /awexen instead.
LMS_BOOTSTRAP_ADMIN_ID=

