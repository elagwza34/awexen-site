<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # security.txt: نتعامل مع .well-known كمجلد حقيقي قبل قاعدة SPA
  # عشان ما يتحوّلش لصفحة React 404
  RewriteCond %{REQUEST_URI} !^\.well-known/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# حماية الملفات الحساسة لو اتسابت للـ public_html.
# .env و .sql و .log هي الأهم — ملفات الـ webmanifest و .well-known
# مسموحة لأنها من ملفات الموقع الفعلية.
<FilesMatch "^(\.env|\.env\..*|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>

# اسم ملف الـ build بيتغيّر مع كل deploy (hash من Vite)، فالملف نفسه
# بيتغير محتواه لما الاسم يتغير. تخزينه سنة كاملة آمن وبيرفع سرعة فتح الموقع.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|svg|webp|avif|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html بيشير للـ chunks اللي كل واحد فيهم hash مختلف،
  # فلازم يتقرأ كل مرة عشان أي نشر جديد يظهر فورًا من غير كاش قديم.
  <FilesMatch "^\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ملفات الموقع الثابتة (robots/sitemap/manifest) بتتغير نادرًا
  <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

