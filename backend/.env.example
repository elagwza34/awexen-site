DJANGO_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_VALUE
AWEXEN_ENV=development
DJANGO_DEBUG=false
ALLOWED_HOSTS=api.awexen.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://awexen.com,https://www.awexen.com,http://127.0.0.1:5173,http://localhost:5173
TIME_ZONE=Africa/Cairo

# استخدم Supabase pooler في staging/production، وPostgreSQL المحلي مع Docker أثناء التطوير.
DATABASE_URL=postgresql://awexen:awexen@127.0.0.1:5432/awexen

# Django يتحقق من Access Tokens الصادرة من Supabase Auth عبر JWKS.
SUPABASE_URL=https://rlppzlcdkwrxsuekszcm.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# مطلوب فقط لمشروعات Supabase القديمة التي ما زالت تستخدم HS256. لا تضعه في frontend.
SUPABASE_JWT_SECRET=
LMS_DEFAULT_ORGANIZATION_SLUG=awexen
LMS_DEFAULT_ORGANIZATION_NAME=Awexen
LMS_BOOTSTRAP_ADMIN_EMAILS=elagwza34@gmail.com
LMS_PAYMENT_PHONE=01092400443
LMS_PAYMENT_PROOFS_BUCKET=payment-proofs
LMS_PAYMENT_PROOF_MAX_BYTES=5242880

# ضع مفتاحًا جديدًا هنا على خادم Django فقط. لا تستخدم VITE_ ولا ترفعه إلى Git.
OPENROUTER_API_KEY=REPLACE_WITH_A_NEW_OPENROUTER_KEY
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://awexen.com
OPENROUTER_SITE_NAME=Ask Awexen
